---
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import { getCollection } from 'astro:content';
import { SITE_NAME, SITE_TAGLINE, SITE_DESCRIPTION } from '../site';

const posts = (await getCollection('news')).sort((a, b) => b.data.pubDate - a.data.pubDate);
const latest = posts.slice(0, 10);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = new URL(Astro.site?.href ?? 'http://localhost:4321');
const siteUrl = new URL(base || '/', site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': siteUrl + '#website',
      name: SITE_NAME,
      url: siteUrl,
      description: SITE_DESCRIPTION,
      inLanguage: 'en',
    },
    {
      '@type': 'Organization',
      '@id': siteUrl + '#organization',
      name: SITE_NAME,
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: new URL(base + '/logo.svg', site).href,
      },
    },
  ],
};
---

<Base title={SITE_NAME} description={SITE_DESCRIPTION} canonicalPath="/">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="hero">
    <span class="chip">⚡ Updated daily</span>
    <h1>{SITE_TAGLINE}</h1>
    <p>Every day we distill the most important technology and AI stories into short, easy reads. Skip the fluff — get the essentials in under two minutes.</p>
  </section>

  <section>
    {latest.map((post) => (
      <NewsCard
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        sourceName={post.data.sourceName}
        href={base + `/article/${post.slug}/`}
        summary={post.data.summary}
      />
    ))}
  </section>

  {posts.length > latest.length && (
    <p class="view-all"><a href={base + '/archive/'}>View all {posts.length} articles →</a></p>
  )}
</Base>

<style>
  .hero { margin-bottom: 36px; }
  .hero h1 {
    margin: 14px 0 12px;
    font-size: 2.1rem;
    line-height: 1.25;
    letter-spacing: 0.3px;
    background: linear-gradient(90deg, #e7eaf2 20%, #9fc3ff 60%, #22d3ee);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero p { color: var(--muted); margin: 0; max-width: 560px; }
  .view-all { margin-top: 26px; }
  .view-all a {
    display: inline-block;
    padding: 10px 22px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    background: linear-gradient(90deg, rgba(79, 140, 255, 0.16), rgba(34, 211, 238, 0.12));
    border: 1px solid var(--border);
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .view-all a:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(79, 140, 255, 0.12);
    text-decoration: none;
  }
  @media (max-width: 560px) {
    .hero h1 { font-size: 1.7rem; }
  }
</style>