---
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news')).sort((a, b) => b.data.pubDate - a.data.pubDate);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const years = [...new Set(posts.map((p) => p.data.pubDate.getFullYear()))];
---

<Base title="All news" description="Every article published on the site." canonicalPath="/archive/">
  <h1 style="font-size:1.5rem;">All articles <span class="muted">({posts.length})</span></h1>

  {years.map((year) => (
    <div style="margin-top:28px;">
      <h2 class="muted" style="font-size:1.05rem; margin-bottom:12px;">{year}</h2>
      {posts
        .filter((p) => p.data.pubDate.getFullYear() === year)
        .map((post) => (
          <NewsCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            sourceName={post.data.sourceName}
            href={base + `/article/${post.slug}/`}
            summary={post.data.summary}
          />
        ))}
    </div>
  ))}
</Base>