---
import { SITE_NAME, SITE_DESCRIPTION, SITE_IMAGE } from '../site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  pubDate?: Date;
  ogType?: 'website' | 'article';
}

const { title, description, canonicalPath = '/', pubDate, ogType = 'website' } = Astro.props;
const site = new URL(Astro.site?.href ?? 'http://localhost:4321');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(base + canonicalPath, site).href;
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="google-site-verification" content="ZtuzCSKLFbVnWzQI4_VJJuQ0rmFUcIHI-HV6j1Vkze8" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(base + SITE_IMAGE, site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(base + SITE_IMAGE, site).href} />

    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

    <link rel="icon" type="image/svg+xml" href={base + '/favicon.svg'} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href={new URL(base + '/rss.xml', site).href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <style>
      :root {
        --bg: #0b0e14;
        --surface: #131722;
        --border: #232a3a;
        --text: #e7eaf2;
        --muted: #9aa3b5;
        --accent: #4f8cff;
        --accent-2: #22d3ee;
        --grad: linear-gradient(90deg, #4f8cff, #22d3ee);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background:
          radial-gradient(1200px 500px at 50% -8%, rgba(79, 140, 255, 0.14), transparent 60%),
          var(--bg);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.65;
      }
      ::selection { background: rgba(79, 140, 255, 0.35); }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .wrap { max-width: 720px; margin: 0 auto; padding: 0 20px; }
      header.site {
        border-bottom: 1px solid var(--border);
        background: rgba(11, 14, 20, 0.85);
        backdrop-filter: blur(8px);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      header.site .wrap { display: flex; align-items: center; gap: 16px; padding-top: 14px; padding-bottom: 14px; }
      header.site .brand { display: flex; align-items: center; gap: 10px; }
      header.site .brand img { display: block; border-radius: 8px; }
      header.site h1 { margin: 0; font-size: 1.22rem; letter-spacing: 0.2px; }
      header.site h1 a { color: var(--text); }
      header.site nav { margin-left: auto; display: flex; gap: 18px; font-size: 0.9rem; }
      header.site nav a { color: var(--muted); transition: color 0.15s ease; }
      header.site nav a:hover { color: var(--text); }
      main { padding: 36px 0 64px; }
      footer.site { border-top: 1px solid var(--border); padding: 32px 0 40px; color: var(--muted); font-size: 0.85rem; }
      footer.site .foot-brand { display: flex; align-items: center; gap: 8px; font-size: 1.02rem; color: var(--text); font-weight: 600; }
      footer.site .foot-brand img { display: block; border-radius: 6px; }
      footer.site .tag { margin: 10px 0 16px; max-width: 420px; }
      footer.site .foot-nav { display: flex; gap: 18px; margin-bottom: 18px; font-size: 0.88rem; }
      footer.site .copy { margin: 0; color: var(--muted); opacity: 0.85; }
      .muted { color: var(--muted); }
      .chip {
        display: inline-block;
        font-size: 0.72rem;
        color: var(--accent-2);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 2px 10px;
        margin-right: 8px;
        background: rgba(34, 211, 238, 0.06);
      }
      @media (max-width: 560px) {
        header.site h1 { font-size: 1.05rem; }
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <div class="brand">
          <img src={base + '/logo.svg'} alt="" width="30" height="30" />
          <h1><a href={base || '/'}>{SITE_NAME}</a></h1>
        </div>
        <nav>
          <a href={base + '/archive/'}>All news</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <div class="foot-brand">
          <img src={base + '/logo.svg'} alt="" width="22" height="22" />
          <span>{SITE_NAME}</span>
        </div>
        <p class="tag">Short, distilled summaries of the latest tech &amp; AI news — refreshed automatically every day.</p>
        <nav class="foot-nav">
          <a href={base || '/'}>Home</a>
          <a href={base + '/archive/'}>All news</a>
        </nav>
        <p class="copy">© {new Date().getFullYear()} {SITE_NAME}. Read smarter, not longer.</p>
      </div>
    </footer>
  </body>
</html>