---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  sourceName?: string;
  href: string;
  summary?: string;
}

const { title, description, pubDate, sourceName, href, summary } = Astro.props;
const formatted = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const words = (summary || '').split(' ').filter(Boolean).length;
const readTime = Math.max(1, Math.round(words / 200));
---

<article class="card">
  <a class="card-link" href={href}>
    <h2>{title}</h2>
    <p>{description}</p>
    <div class="meta">
      <span class="date">{formatted}</span>
      {summary && <span class="muted">· ~{readTime} min read</span>}
      <span class="arrow">→</span>
    </div>
  </a>
</article>

<style>
  .card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px 22px;
    margin-bottom: 16px;
    background: linear-gradient(180deg, var(--surface), var(--surface-2));
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--grad);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(168, 85, 247, 0.16);
  }
  .card:hover::before { opacity: 1; }
  .card-link { color: var(--text); display: block; }
  .card-link:hover { text-decoration: none; }
  h2 { margin: 0 0 6px; font-size: 1.12rem; font-weight: 600; line-height: 1.4; letter-spacing: 0.1px; }
  p { margin: 0 0 10px; color: var(--muted); font-size: 0.92rem; line-height: 1.6; }
  .meta { display: flex; align-items: center; gap: 6px; font-size: 0.78rem; color: var(--muted); }
  .date { color: var(--accent-2); }
  .arrow {
    margin-left: auto;
    color: var(--accent);
    font-size: 1.05rem;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .card:hover .arrow { opacity: 1; transform: translateX(0); }
</style>